{
  "name": "A-GPS (Account Growth Propensity Scoring)",
  "version": "1.0.0",
  "scale": {
    "best": 1,
    "worst": 8,
    "missing_score": 8,
    "note": "Golf-style: lower is better. Bands use min (inclusive) and max_exclusive; null = open-ended."
  },
  "boolean_values": {
    "true": [
      "true",
      "t",
      "yes",
      "y",
      "1"
    ],
    "false": [
      "false",
      "f",
      "no",
      "n",
      "0"
    ]
  },
  "bucket_weights": {
    "gtm_propensity": 0.3,
    "marketing_programmatic_engagement": 0.1,
    "post_sales": 0.25,
    "product": 0.1,
    "down_and_distance": 0.25
  },
  "rounding": {
    "bucket_scores": 2,
    "overall_score": 3
  },
  "cluster": {
    "method": "median_2x2",
    "quartile": {
      "order": "overall_score ascending",
      "tiebreak": "higher arr first, then input order",
      "labels": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "note": "Same as Postgres ntile(4): P1 = best 25%."
    },
    "growth_arr_2x2": {
      "arr_high_max_band": 4,
      "growth_split": "median",
      "note": "Growth = overall excluding the arr field. P1 high growth+high ARR, P2 high growth, P3 high ARR, P4 neither."
    },
    "watch": {
      "nrr_below": 90,
      "growth_worse_than": 6.0
    }
  },
  "focus": {
    "count": 3,
    "window_days": 120,
    "rule": "The lowest overall scores among accounts renewing within window_days; ties break toward sooner renewal, then name. If fewer than count qualify, the next-soonest renewals fill the list."
  },
  "plays": {
    "P1": "Expand now: exec-aligned expansion plays, multi-thread, pull in AE + SE",
    "P2": "Grow into it: land-and-expand motions, programs, scale CS",
    "P3": "Protect & re-ignite: retention-first, fix health, find the next use case",
    "P4": "Scale & monitor: digital/pooled CS, watch for signals"
  },
