{
  "name": "A-GPS v2 (Account Growth Propensity Scoring)",
  "version": "2.0.0",
  "scale": {
    "best": 1,
    "worst": 8,
    "missing_score": 8
  },
  "options": {
    "renewal_direction": "sooner_is_better",
    "not_applicable": "exclude",
    "empty_bucket": "renormalize",
    "size_normalization": false,
    "min_closed_opps": 3,
    "min_survey_responses": 3,
    "use_field_weights": false,
    "arr_scoring": "absolute",
    "segment_field": null,
    "stale_rag_penalty": false
  },
  "bucket_weights": {
    "gtm_propensity": 0.3,
    "post_sales": 0.25,
    "down_and_distance": 0.25,
    "marketing_programmatic_engagement": 0.1,
    "product": 0.1
  },
  "section_to_bucket": {
    "GTM": "gtm_propensity",
    "Marketing | Customer Programs Engagement": "marketing_programmatic_engagement",
    "Customer Success / Support / Services": "post_sales",
    "Product": "product",
    "Situation & Timing": "down_and_distance"
  },
  "rounding": {
    "bucket_scores": 2,
    "overall_score": 3
  },
  "cluster": {
    "method": "median_2x2",
    "quartile": {
      "labels": [
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "growth_arr_2x2": {
      "arr_high_max_band": 4
    },
    "watch": {
      "nrr_below": 90,
      "growth_worse_than": 6.0
    }
  },
  "focus": {
    "count": 3,
    "window_days": 120,
    "renewal_field": "days_to_next_event"
  },
  "plays": {
    "P1": "Expand now: exec-aligned expansion, multi-thread, bring in AE + SE",
    "P2": "Grow into it: land-and-expand, programs, close the weakest bucket first",
    "P3": "Protect and re-ignite: retention first, fix health, find the next use case",
    "P4": "Scale and monitor: digital or pooled CS, watch for signals"
  },
  "fields": {
